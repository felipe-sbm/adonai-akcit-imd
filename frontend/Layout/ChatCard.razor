@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using System.Text.RegularExpressions
@using adonai.Services
@using Markdig
@inject CodeReviewService ReviewService

<div class="card">
    <div class="chat-history">
        @foreach (var item in _messages)
        {
            <div class="message">
                @if (item.IsAi)
                {
                    <div class="avatar d-flex align-content-end flex-wrap">
                        <img src="@GetAvatarPath(item.Emotion)" alt="Avatar da Adonai">
                    </div>
                    <div class="ai-text markdown-content">@((MarkupString)RenderMarkdown(StripEmotionMarker(item.Text)))</div>
                }
                else
                {
                    <p class="human-text">@item.Text</p>
                }
            </div>
        }

        @if (_isSending)
        {
            <div class="message">
                <div class="avatar d-flex align-content-end flex-wrap">
                    <img src="images/assets/think.webp" alt="Avatar da Adonai">
                </div>
                <p class="ai-text">Estou pensando...</p>
            </div>
        }
        </div>


        <div class="input-area">
            <label
                for="fileInput" class="file-button" 
                title="@(_selectedFile?.Name ?? "Selecionar arquivo")"
                data-placement="top">
                @if (_selectedFile == null)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-paperclip" viewBox="0 0 16 16">
                        <path d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0z"/>
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-check" viewBox="0 0 16 16">
                        <path d="M10.854 7.854a.5.5 0 0 0-.708-.708L7.5 9.793 6.354 8.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0z"/>
                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
                    </svg>
                }
            </label>

            <!-- input real escondido; o id liga ao for do label -->
            <InputFile id="fileInput" hidden OnChange="OnInputFileChange"
                    accept=".cs,.js,.ts,.py,.java,.jl,.cpp,.c,.razor,.html,.css,.scss,.sass,.json,.xml,.txt,.md,.mdx" />

            <textarea
                class="text-area"
                placeholder="Escreva o que você quer ver sobre o seu código..."
                @bind="_message"
            >
            </textarea>
            <button
                class="send-button"
                title="Enviar"
                data-toggle="tooltip"
                data-placement="top"
                @onclick="SendAsync"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-arrow-up"
                    viewBox="0 0 16 16"
                >
                    <path fill-rule="evenodd"
                          d="M8 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 1 0 .708.708L7.5 2.707V14.5a.5.5 0 0 0 .5.5"
                    />
                </svg>
            </button>
        </div>
    </div>


@code {
    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private sealed record ChatMessage(bool IsAi, string Text, string? Emotion = null);

    private IBrowserFile? _selectedFile;
    private string _message = string.Empty;
    private bool _isSending;
    private readonly List<ChatMessage> _messages =
    [
        new(true, "Olá, qual código você quer analisar hoje?", "cumprimentando")
    ];

    private static string GetAvatarPath(string? emotion)
    {
        return emotion?.ToLowerInvariant() switch
        {
            "raiva" => "images/assets/angry.webp",
            "star_struck" => "images/assets/awesome.webp",
            "vergonha" => "images/assets/awkward.webp",
            "piscada" => "images/assets/blink.webp",
            "emburrada" => "images/assets/bruh.webp",
            "medo" => "images/assets/scared.webp",
            "parabens" => "images/assets/congratulations.webp",
            "choro" => "images/assets/cry.webp",
            "muito_choro" => "images/assets/crying-alot.webp",
            "rejeitando" => "images/assets/decline.webp",
            "depressiva" => "images/assets/depressed.webp",
            "explicativa" => "images/assets/explain.webp",
            "face_palm" => "images/assets/face-palm.webp",
            "hangloose" => "images/assets/hangloose.webp",
            "feliz" => "images/assets/happy.webp",
            "cabeca_explodindo" => "images/assets/head-explosion.webp",
            "coracao" => "images/assets/heart.webp",
            "cumprimentando" => "images/assets/hello-world.webp",
            "ideia" => "images/assets/idea.webp",
            "agradecimento" => "images/assets/thanks.webp",
            "rindo" => "images/assets/laugh.webp",
            "joinha" => "images/assets/like.webp",
            "tapando_boca" => "images/assets/shrug.webp",
            "nervosa" => "images/assets/stop-it.webp",
            "shrug" => "images/assets/shrug.webp",
            "canto_de_olho" => "images/assets/side-eye.webp",
            "rejeitando_para" => "images/assets/no-commentary.webp",
            "muito_agradecida" => "images/assets/joyful.webp",
            "pensando" => "images/assets/think.webp",
            "deslike" => "images/assets/unlike.webp",
            "muita_raiva" => "images/assets/very-angry.webp",
            _ => "images/assets/side-eye.webp",
        };
    }

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        await InvokeAsync(StateHasChanged);
    }

    private static string RenderMarkdown(string text)
    {
        return Markdown.ToHtml(text, MarkdownPipeline);
    }

    private static string StripEmotionMarker(string text)
    {
        var lines = text
            .Split('\n')
            .Where(line => !line.TrimStart().StartsWith("EMOCAO:", StringComparison.OrdinalIgnoreCase));

        return string.Join("\n", lines).Trim();
    }

    private async Task SendAsync()
    {
        if (_isSending)
        {
            return;
        }


        if (string.IsNullOrWhiteSpace(_message))
        {
            _messages.Add(new ChatMessage(true, "Me conta a tarefa que você quer que eu avalie no código."));
            await InvokeAsync(StateHasChanged);
            return;
        }

        var prompt = _message.Trim();
        _messages.Add(new ChatMessage(false, prompt));
        _isSending = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await ReviewService.SubmitCodeReviewAsync(_selectedFile, prompt);
            _messages.Add(new ChatMessage(true, result.Message, result.Emotion));
            
            // Limpar campos após sucesso
            _selectedFile = null;
            _message = string.Empty;
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage(true, $"Erro ao enviar revisão: {ex.Message}", "depressiva"));
        }
        finally
        {
            _isSending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // Source - https://stackoverflow.com/questions/62022890/blazor-file-upload-iformfile
    // Posted by Osman Taskiran
    // Retrieved 3/14/2026, License - CC BY-SA 4.0
}
