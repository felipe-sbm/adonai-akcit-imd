@using Microsoft.AspNetCore.Components.Forms
@using System.Text.RegularExpressions
@inject HttpClient Http

<div class="card">
    <div class="chat-history">
        @* Mensagem da Adonai *@
        <div class="message">
            <div class="avatar d-flex align-content-end flex-wrap ">
                <img src="images/assets/side-eye.webp" alt="Adonai fazendo Joinha">
            </div>
            <p class="ai-text">Faaala rapaz, qual código você quer que eu analise?</p>
        </div>
        
        @* Mensagem do usuário *@
        <div class="message">
            <p class="human-text">
                Mana, queria que você olhasse esse problema de compilação que tô tendo aqui no javascript.</p>
            </div>
        </div>


        <div class="input-area">
            <label
                for="fileInput" class="file-button" 
                title="@(_selectedFile?.Name ?? "Selecionar arquivo")"
                data-placement="top">
                @if (_selectedFile == null)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-paperclip" viewBox="0 0 16 16">
                        <path d="M4.5 3a2.5 2.5 0 0 1 5 0v9a1.5 1.5 0 0 1-3 0V5a.5.5 0 0 1 1 0v7a.5.5 0 0 0 1 0V3a1.5 1.5 0 1 0-3 0v9a2.5 2.5 0 0 0 5 0V5a.5.5 0 0 1 1 0v7a3.5 3.5 0 1 1-7 0z"/>
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-check" viewBox="0 0 16 16">
                        <path d="M10.854 7.854a.5.5 0 0 0-.708-.708L7.5 9.793 6.354 8.646a.5.5 0 1 0-.708.708l1.5 1.5a.5.5 0 0 0 .708 0z"/>
                        <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
                    </svg>
                }
            </label>

            <!-- input real escondido; o id liga ao for do label -->
            <InputFile id="fileInput" hidden OnChange="OnInputFileChange"
                    accept=".cs,.js,.py,.java,.cpp,.razor,.html,.css,.json,.xml" />

            <textarea
                class="text-area"
                name=""
                id=""
                placeholder="Escreva o que você quer ver sobre o seu código..."
            >
            </textarea>
            <button
                class="send-button"
                title="Enviar"
                data-toggle="tooltip"
                data-placement="top"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    fill="currentColor"
                    class="bi bi-arrow-up"
                    viewBox="0 0 16 16"
                >
                    <path fill-rule="evenodd"
                          d="M8 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 1 0 .708.708L7.5 2.707V14.5a.5.5 0 0 0 .5.5"
                    />
                </svg>
            </button>
        </div>
    </div>


@code {
    private IBrowserFile? _selectedFile;
    private string _message = string.Empty;

    private async Task OnInputFileChange(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        StateHasChanged();
    }

    private async Task SendAsync()
    {
        if (_selectedFile == null) {
            return;
        }

        using var content = new MultipartFormDataContent();
        var stream = _selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 50);
        var streamContent = new StreamContent(stream);
        streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
            _selectedFile.ContentType ?? "application/octet-stream");

        content.Add(streamContent, "file", _selectedFile.Name);
        content.Add(new StringContent(_message ?? ""), "meuCampoTexto");

        var response = await Http.PostAsync("https://localhost:2518", content);
        response.EnsureSuccessStatusCode();
    }

    // Source - https://stackoverflow.com/questions/62022890/blazor-file-upload-iformfile
    // Posted by Osman Taskiran
    // Retrieved 3/14/2026, License - CC BY-SA 4.0
}
